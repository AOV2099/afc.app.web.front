# Public runtime values
# Leave empty behind the gateway so API requests remain same-origin through /api.
PUBLIC_API_BASE_URL=
PUBLIC_GOOGLE_CLIENT_ID=
# direct = current Google popup; gateway = relative GET /auth/google
PUBLIC_GOOGLE_AUTH_MODE=direct

# Internal backend URL used only by SvelteKit SSR
AFC_BACKEND_URL=http://localhost:3000

# Option A: provide absolute paths available inside container/host
VITE_DEV_HTTPS_KEY_PATH=
VITE_DEV_HTTPS_CERT_PATH=

# Option B: provide PEM content directly (can include \n escaped newlines)
VITE_DEV_HTTPS_KEY=
VITE_DEV_HTTPS_CERT=

# Option C: provide base64 PEM content
VITE_DEV_HTTPS_KEY_BASE64=
VITE_DEV_HTTPS_CERT_BASE64=
